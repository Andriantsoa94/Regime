    padding: 0;
}

.alert ul {
    margin-bottom: 0;
    padding-left: 20px;
}

.alert li {
    margin-bottom: 5px;
}

/* IMC Preview Styling */
#imc-preview {
    text-align: center;
    padding: 20px;
    font-size: 16px;
}

.imc-value {
    font-size: 32px;
    font-weight: bold;
    color: #007bff;
}

.imc-category {
    margin-top: 10px;
    font-size: 14px;
}
</style>

<script>
// Calcul dynamique de l'IMC
document.addEventListener('DOMContentLoaded', function() {
    const tailleInput = document.getElementById('taille');
    const poidsInput = document.getElementById('poids');
    const imcPreview = document.getElementById('imc-preview');

    function calculateIMC() {
        const taille = parseFloat(tailleInput.value);
        const poids = parseFloat(poidsInput.value);

        if (!taille || !poids || taille <= 0 || poids <= 0) {
            imcPreview.innerHTML = 'Remplissez la taille et le poids pour voir votre IMC estimé';
            return;
        }

        const tailleMetre = taille / 100;
        const imc = (poids / (tailleMetre * tailleMetre)).toFixed(2);

        let category = '';
        if (imc < 18.5) category = 'Poids insuffisant';
        else if (imc < 25) category = 'Poids normal';
        else if (imc < 30) category = 'Surpoids';
        else if (imc < 35) category = 'Obésité classe 1';
        else if (imc < 40) category = 'Obésité classe 2';
        else category = 'Obésité classe 3';

        imcPreview.innerHTML = `
            <div class="imc-value">${imc}</div>
            <div class="imc-category">${category}</div>
        `;
    }

    tailleInput.addEventListener('input', calculateIMC);
    poidsInput.addEventListener('input', calculateIMC);

    // Calcul initial
    calculateIMC();
});
</script>
