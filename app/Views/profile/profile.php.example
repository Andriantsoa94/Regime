                    <?php if ($imc) : ?>
                    <p class="mt-3"><strong>IMC:</strong></p>
                    <div class="progress">
                        <div class="progress-bar" style="width: <?= min($imc / 40 * 100, 100) ?>%">
                            <?= number_format($imc, 1) ?>
