                                        <span class="text-muted">Non calculable</span>
                                    <?php endif; ?>
                                </td>
                            </tr>
                        </table>
                    </div>
                    <?php else : ?>
                    <div class="alert alert-info mt-4">
                        <strong>Info:</strong> Pas de données de santé renseignées.
                        <a href="/profile/edit" class="alert-link">Ajouter vos informations</a>
