                                <td><strong>Poids:</strong></td>
                                <td><?= $sante['poids'] ?? 'Non renseigné' ?> kg</td>
                            </tr>
                            <tr>
                                <td><strong>IMC (Indice de Masse Corporelle):</strong></td>
                                <td>
                                    <?php if ($imc) : ?>
                                        <span class="badge badge-info"><?= number_format($imc, 2) ?></span>
