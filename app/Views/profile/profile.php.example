                    <?php if ($sante) : ?>
                    <div class="section-info mt-4">
                        <h3>Données de Santé</h3>
                        <table class="table table-borderless">
                            <tr>
                                <td><strong>Taille:</strong></td>
                                <td><?= $sante['taille'] ?? 'Non renseignée' ?> cm</td>
